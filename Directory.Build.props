<Project>
  <PropertyGroup>
    <!--
      Версия лаунчера по схеме 0.Y.X (см. README, «Версии»):
        исправления  → X+1        (0.3.0 → 0.3.1)
        новые функции → Y+1, X=0  (0.3.1 → 0.4.0)
      Первое число всегда 0. После 9 идёт 10: 0.9.0 → 0.10.0.
      Перед релизом поднимите версию и создайте тег v0.Y.X.
    -->
    <Version>0.12.1</Version>

    <!--
      Client ID приложения Azure (Microsoft Entra), одобренного Mojang для Minecraft API.
      Вшивается в лаунчер, поэтому игрокам ничего не нужно настраивать — они сразу входят через Microsoft.
      Это не секрет (публичный клиент без пароля), его можно хранить в репозитории.
      Как получить — README, раздел «Вход через Microsoft: Client ID».
    -->
    <GLauncherClientId>ff868374-2b04-4039-9e81-6ebe1c66969c</GLauncherClientId>
  </PropertyGroup>
</Project>


