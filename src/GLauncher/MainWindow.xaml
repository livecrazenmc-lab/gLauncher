<Window x:Class="GLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GLauncher.Views"
        xmlns:themes="clr-namespace:GLauncher.Themes"
        Title="gLauncher" Icon="Assets/gLauncher.ico" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBase}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Text}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- Своя рамка окна: заголовок рисует лаунчер, Windows отвечает за перетаскивание, привязку и изменение размера -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ===== Фон: градиент темы, два «сияния» акцентных цветов, изометрическая сетка, частицы ===== -->
        <Border Background="{DynamicResource Brush.WindowBase}" />
        <Border Background="{DynamicResource Brush.Aurora1}" />
        <Border Background="{DynamicResource Brush.Aurora2}" />
        <Border Background="{DynamicResource Brush.Pattern}" />
        <themes:ParticleField IsActive="{Binding SettingsPage.AnimatedBackground}" />

        <DockPanel>
            <!-- ===== Заголовок окна: иконка gLauncher, название, версия, приветствие, кнопки окна ===== -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="{StaticResource Img.Logo}" Width="24" Height="24" />
                    <TextBlock x:Name="Logo" Background="Transparent" Margin="10,0,0,1" VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Display}" FontSize="17" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Run Text="g" Foreground="{DynamicResource Brush.Accent}" /><Run Text="Launcher" />
                    </TextBlock>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}">
                            <Run Text="v" /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CreditedPerson.Greeting}" VerticalAlignment="Center" Margin="0,0,18,0"
                               FontFamily="{DynamicResource Font.Display}" Foreground="{DynamicResource Brush.TextGold}"
                               Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Развернуть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Закрыть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ===== Поздравление в день рождения активного аккаунта ===== -->
            <Border x:Name="BirthdayBanner" DockPanel.Dock="Top" Margin="12,0,12,12" Padding="16,10" CornerRadius="14"
                    Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1"
                    Visibility="{Binding Accounts.BirthdayGreeting, Converter={StaticResource NotNullToVisibility}}">
                <DockPanel>
                    <Button x:Name="BirthdayClose" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="34" Height="34"
                            Content="&#xE711;" FontSize="11" ToolTip="Скрыть" VerticalAlignment="Center" />
                    <TextBlock Text="&#x1F382;" FontFamily="Segoe UI Emoji" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Accounts.BirthdayGreeting}" FontFamily="{DynamicResource Font.Display}" FontSize="16"
                                   Foreground="{DynamicResource Brush.TextGold}" />
                        <TextBlock Text="Лаунчер празднует вместе с вами: сегодня у него праздничное оформление." Style="{StaticResource HintText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== Баннер обновления: виден, когда на GitHub есть версия новее ===== -->
            <Border DockPanel.Dock="Top" Margin="12,0,12,12" Padding="16,10" CornerRadius="14"
                    Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1"
                    Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{Binding Updates.InstallButtonText}" Command="{Binding Updates.InstallCommand}" Style="{StaticResource AccentButton}" Margin="6,0,0,0" />
                        <Button Content="Что нового" Command="{Binding Updates.OpenReleasePageCommand}" Margin="6,0,0,0" />
                        <Button Content="Позже" Command="{Binding Updates.DismissCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updates.AvailableText}" FontWeight="SemiBold" />
                        <ProgressBar Margin="0,6,12,0" Value="{Binding Updates.ProgressValue}"
                                     Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        <!-- Боковая панель как в официальном лаунчере: игрок сверху, игры, «Настройки» внизу.
             У каждой игры своя страница с вкладками (Играть, Установки, Скины, Список изменений…). -->
        <!-- ItemContainerStyle, а не неявный стиль: иначе вложенные вкладки страниц тоже станут пунктами меню -->
        <TabControl x:Name="Sidebar" Style="{StaticResource SidebarTabControl}" ItemContainerStyle="{StaticResource NavItem}">

            <!-- Игрок: карточка активного аккаунта с выпадающим списком; без аккаунта — кнопка «Добавить аккаунт» -->
            <TabItem Style="{StaticResource NavSlot}">
                <TabItem.Header>
                    <views:AccountSwitcher />
                </TabItem.Header>
            </TabItem>

            <TabItem Header="ИГРЫ" Style="{StaticResource NavSection}" />

            <!-- Java Edition -->
            <TabItem IsSelected="True">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Java Edition" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <!-- Своя пиксельная иконка издания (EditionIcons.cs) -->
                        <Image Source="{x:Static themes:EditionIcons.Java}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center" Style="{StaticResource NavLabelPanel}">
                            <TextBlock Text="MINECRAFT" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="JAVA EDITION" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:JavaPlayView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Установки"><views:JavaInstallationsView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Скины"><views:SkinsView DataContext="{Binding Skins}" /></TabItem>
                    <TabItem Header="Моды"><views:ContentView DataContext="{Binding Content}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding JavaPatchNotes}" /></TabItem>
                    <TabItem Header="Журнал"><views:JavaLogView DataContext="{Binding Java}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Bedrock Edition -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Bedrock Edition" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <!-- Своя пиксельная иконка издания (EditionIcons.cs) -->
                        <Image Source="{x:Static themes:EditionIcons.Bedrock}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center" Style="{StaticResource NavLabelPanel}">
                            <TextBlock Text="MINECRAFT" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="BEDROCK EDITION" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:BedrockView DataContext="{Binding Bedrock}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Bedrock.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons II -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Minecraft Dungeons II" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <!-- Своя пиксельная иконка издания (EditionIcons.cs) -->
                        <Image Source="{x:Static themes:EditionIcons.DungeonsII}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center" Style="{StaticResource NavLabelPanel}">
                            <TextBlock Text="MINECRAFT" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="DUNGEONS II" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding DungeonsII}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Minecraft Dungeons" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <!-- Своя пиксельная иконка издания (EditionIcons.cs) -->
                        <Image Source="{x:Static themes:EditionIcons.Dungeons}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center" Style="{StaticResource NavLabelPanel}">
                            <TextBlock Text="MINECRAFT" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="DUNGEONS" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Dungeons}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Dungeons.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Legends -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Minecraft Legends" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <!-- Своя пиксельная иконка издания (EditionIcons.cs) -->
                        <Image Source="{x:Static themes:EditionIcons.Legends}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center" Style="{StaticResource NavLabelPanel}">
                            <TextBlock Text="MINECRAFT" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" />
                            <TextBlock Text="LEGENDS" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Legends}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Legends.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Настройки — внизу панели -->
            <TabItem DockPanel.Dock="Bottom">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" ToolTip="Настройки" ToolTipService.IsEnabled="{Binding SidebarCollapsed}" Background="Transparent">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" VerticalAlignment="Center" Style="{StaticResource NavLabel}" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>

            <!-- Свернуть/развернуть панель (над «Настройками»): в свёрнутом виде остаются только иконки -->
            <TabItem Style="{StaticResource NavSlot}" DockPanel.Dock="Bottom">
                <TabItem.Header>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="{Binding SidebarToggleText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Width="32" TextAlignment="Center" Margin="0,0,12,0"
                                       VerticalAlignment="Center" Text="{Binding SidebarToggleGlyph}" />
                            <TextBlock Text="{Binding SidebarToggleText}" VerticalAlignment="Center" Style="{StaticResource NavLabel}" />
                        </StackPanel>
                    </Button>
                </TabItem.Header>
            </TabItem>
        </TabControl>
        </DockPanel>

        <!-- Слой для пасхалки (падающие блоки) — поверх всего, клики проходят насквозь -->
        <Canvas x:Name="FxLayer" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</Window>

