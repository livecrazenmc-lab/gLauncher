<Window x:Class="GLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GLauncher.Views"
        xmlns:themes="clr-namespace:GLauncher.Themes"
        Title="gLauncher" Icon="Assets/gLauncher.ico" Width="1080" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Texture.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <DockPanel>
        <!-- Шапка: полоса дёрна с травой и название -->
        <Grid DockPanel.Dock="Top" Height="72">
            <Border Background="{DynamicResource Texture.Header}" />
            <Border Background="#59000000" Margin="0,18,0,0" />
            <Border BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="0,0,0,3" />
            <DockPanel Margin="18,18,18,6">
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" Effect="{StaticResource Effect.TextShadow}">
                        <Run Text="Игрок:" Foreground="{DynamicResource Brush.TextDim}" />
                        <Run Text="{Binding Accounts.Selected.DisplayName, Mode=OneWay, FallbackValue='не выбран', TargetNullValue='не выбран'}"
                             FontWeight="Bold" />
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextDim}" FontSize="11"
                               Effect="{StaticResource Effect.TextShadow}">
                        <Run Text="версия" />
                        <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontSize="30" FontWeight="Black"
                           Effect="{StaticResource Effect.TextShadow}">
                    <Run Text="g" Foreground="{DynamicResource Brush.AccentLight}" /><Run Text="Launcher" />
                </TextBlock>
            </DockPanel>
        </Grid>

        <!-- Баннер обновления: виден, когда на GitHub есть версия новее -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="0,0,0,2" Padding="12,8"
                Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Обновить" Command="{Binding Updates.InstallCommand}" Background="{DynamicResource Brush.Accent}" Margin="6,0,0,0" />
                    <Button Content="Что нового" Command="{Binding Updates.OpenReleasePageCommand}" Margin="6,0,0,0" />
                    <Button Content="Позже" Command="{Binding Updates.DismissCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Updates.AvailableText}" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}" />
                    <ProgressBar Margin="0,4,12,0" Value="{Binding Updates.ProgressValue}"
                                 Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Margin="12,8,12,12">
            <TabItem Header="Java Edition">
                <views:JavaView DataContext="{Binding Java}" />
            </TabItem>
            <TabItem Header="Контент">
                <views:ContentView DataContext="{Binding Content}" />
            </TabItem>
            <TabItem Header="Скины">
                <views:SkinsView DataContext="{Binding Skins}" />
            </TabItem>
            <TabItem Header="Bedrock Edition">
                <views:BedrockView DataContext="{Binding Bedrock}" />
            </TabItem>
            <TabItem Header="Аккаунты">
                <views:AccountsView DataContext="{Binding Accounts}" />
            </TabItem>
            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>



