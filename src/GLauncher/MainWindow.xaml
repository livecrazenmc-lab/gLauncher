<Window x:Class="GLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GLauncher.Views"
        Title="gLauncher" Width="1000" Height="700" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Баннер обновления: виден, когда на GitHub есть версия новее -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="Gray" Padding="8"
                Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Обновить" Command="{Binding Updates.InstallCommand}" Padding="12,4" Margin="6,0,0,0" FontWeight="Bold" />
                    <Button Content="Что нового" Command="{Binding Updates.OpenReleasePageCommand}" Padding="8,4" Margin="6,0,0,0" />
                    <Button Content="Позже" Command="{Binding Updates.DismissCommand}" Padding="8,4" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Updates.AvailableText}" />
                    <ProgressBar Height="6" Margin="0,4,0,0" Value="{Binding Updates.ProgressValue}"
                                 Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Нижняя строка: активный аккаунт -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Аккаунт:" />
                    <Run Text="{Binding Accounts.Selected.DisplayName, Mode=OneWay, FallbackValue='не выбран', TargetNullValue='не выбран'}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="gLauncher" />
                    <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="Java Edition">
                <views:JavaView DataContext="{Binding Java}" />
            </TabItem>
            <TabItem Header="Контент">
                <views:ContentView DataContext="{Binding Content}" />
            </TabItem>
            <TabItem Header="Bedrock Edition">
                <views:BedrockView DataContext="{Binding Bedrock}" />
            </TabItem>
            <TabItem Header="Аккаунты">
                <views:AccountsView DataContext="{Binding Accounts}" />
            </TabItem>
            <TabItem Header="Настройки">
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
