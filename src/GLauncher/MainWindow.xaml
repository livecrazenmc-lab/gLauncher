<Window x:Class="GLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GLauncher.Views"
        xmlns:themes="clr-namespace:GLauncher.Themes"
        Title="gLauncher" Icon="Assets/gLauncher.ico" Width="1180" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.WindowBase}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- Своя рамка окна: заголовок рисует лаунчер, Windows отвечает за перетаскивание, привязку и изменение размера -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ===== Фон: градиент темы, два «сияния» акцентных цветов, изометрическая сетка, частицы ===== -->
        <Border Background="{DynamicResource Brush.WindowBase}" />
        <Border Background="{DynamicResource Brush.Aurora1}" />
        <Border Background="{DynamicResource Brush.Aurora2}" />
        <Border Background="{DynamicResource Brush.Pattern}" />
        <themes:ParticleField IsActive="{Binding SettingsPage.AnimatedBackground}" />

        <DockPanel>
            <!-- ===== Заголовок окна: иконка gLauncher, название, версия, приветствие, кнопки окна ===== -->
            <Grid DockPanel.Dock="Top" Height="44">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/gLauncher.ico" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="Logo" Background="Transparent" Margin="10,0,0,1" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}" FontSize="17" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Run Text="g" Foreground="{DynamicResource Brush.Accent}" /><Run Text="Launcher" />
                    </TextBlock>
                    <Border Style="{StaticResource Chip}" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}">
                            <Run Text="v" /><Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CreditedPerson.Greeting}" VerticalAlignment="Center" Margin="0,0,18,0"
                               FontFamily="{StaticResource Font.Display}" Foreground="{DynamicResource Brush.TextGold}"
                               Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Развернуть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" ToolTip="Закрыть"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ===== Баннер обновления: виден, когда на GitHub есть версия новее ===== -->
            <Border DockPanel.Dock="Top" Margin="12,0,12,12" Padding="16,10" CornerRadius="14"
                    Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1"
                    Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Обновить" Command="{Binding Updates.InstallCommand}" Style="{StaticResource AccentButton}" Margin="6,0,0,0" />
                        <Button Content="Что нового" Command="{Binding Updates.OpenReleasePageCommand}" Margin="6,0,0,0" />
                        <Button Content="Позже" Command="{Binding Updates.DismissCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Updates.AvailableText}" FontWeight="SemiBold" />
                        <ProgressBar Margin="0,6,12,0" Value="{Binding Updates.ProgressValue}"
                                     Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        <!-- Боковая панель как в официальном лаунчере: игрок сверху, игры, «Настройки» внизу.
             У каждой игры своя страница с вкладками (Играть, Установки, Скины, Список изменений…). -->
        <!-- ItemContainerStyle, а не неявный стиль: иначе вложенные вкладки страниц тоже станут пунктами меню -->
        <TabControl Style="{StaticResource SidebarTabControl}" ItemContainerStyle="{StaticResource NavItem}">

            <!-- Игрок -->
            <TabItem>
                <TabItem.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="12"
                                BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1.5" Background="{DynamicResource Brush.Face}">
                            <Image Source="{Binding Accounts.ActiveFace}" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1">
                                <Image.Clip><RectangleGeometry Rect="0,0,35,35" RadiusX="10" RadiusY="10" /></Image.Clip>
                            </Image>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Accounts.Selected.DisplayName, FallbackValue='Нет аккаунта', TargetNullValue='Нет аккаунта'}"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCredited}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextGold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextGold}"
                                       Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="★" /> <Run Text="{Binding CreditedPerson.Role, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Accounts.ActiveSubtitle}" FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </DockPanel>
                </TabItem.Header>
                <views:AccountsView DataContext="{Binding Accounts}" />
            </TabItem>

            <TabItem Header="ИГРЫ" Style="{StaticResource NavSection}" />

            <!-- Java Edition -->
            <TabItem IsSelected="True">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Margin="0,0,12,0" CornerRadius="7" ClipToBounds="True"
                                Background="{themes:PixelTexture Kind=GrassBlock, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding JavaIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="7" RadiusY="7" /></Image.Clip></Image>
                        </Border>
                        <TextBlock Text="Java Edition" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:JavaPlayView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Установки"><views:JavaInstallationsView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Скины"><views:SkinsView DataContext="{Binding Skins}" /></TabItem>
                    <TabItem Header="Моды"><views:ContentView DataContext="{Binding Content}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding JavaPatchNotes}" /></TabItem>
                    <TabItem Header="Журнал"><views:JavaLogView DataContext="{Binding Java}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Bedrock Edition -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Margin="0,0,12,0" CornerRadius="7" ClipToBounds="True"
                                Background="{themes:PixelTexture Kind=Stone, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding BedrockIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="7" RadiusY="7" /></Image.Clip></Image>
                        </Border>
                        <TextBlock Text="Bedrock Edition" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:BedrockView DataContext="{Binding Bedrock}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Bedrock.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Margin="0,0,12,0" CornerRadius="7" ClipToBounds="True"
                                Background="{themes:PixelTexture Kind=Planks, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding DungeonsIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="7" RadiusY="7" /></Image.Clip></Image>
                        </Border>
                        <TextBlock Text="Minecraft Dungeons" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Dungeons}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Dungeons.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons II -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Margin="0,0,12,0" CornerRadius="7" ClipToBounds="True"
                                Background="{themes:PixelTexture Kind=DarkPlanks, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding DungeonsIIIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="7" RadiusY="7" /></Image.Clip></Image>
                        </Border>
                        <TextBlock Text="Minecraft Dungeons II" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding DungeonsII}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Legends -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" Margin="0,0,12,0" CornerRadius="7" ClipToBounds="True"
                                Background="{themes:PixelTexture Kind=MossyStone, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding LegendsIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"><Image.Clip><RectangleGeometry Rect="0,0,26,26" RadiusX="7" RadiusY="7" /></Image.Clip></Image>
                        </Border>
                        <TextBlock Text="Minecraft Legends" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Legends}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Legends.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Настройки — внизу панели -->
            <TabItem DockPanel.Dock="Bottom">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="26" TextAlignment="Center" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>
        </TabControl>
        </DockPanel>

        <!-- Слой для пасхалки (падающие блоки) — поверх всего, клики проходят насквозь -->
        <Canvas x:Name="FxLayer" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</Window>

