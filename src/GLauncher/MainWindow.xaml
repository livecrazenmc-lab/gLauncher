<Window x:Class="GLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GLauncher.Views"
        xmlns:themes="clr-namespace:GLauncher.Themes"
        Title="gLauncher" Icon="Assets/gLauncher.ico" Width="1080" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Texture.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
    <DockPanel>
        <!-- Шапка: полоса дёрна с травой и название -->
        <Grid DockPanel.Dock="Top" Height="72">
            <Border Background="{DynamicResource Texture.Header}" />
            <Border Background="#59000000" Margin="0,18,0,0" />
            <Border BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="0,0,0,3" />
            <DockPanel Margin="18,18,18,6">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CreditedPerson.Greeting}" VerticalAlignment="Center" Margin="24,0,0,0"
                           FontWeight="Bold" Foreground="{DynamicResource Brush.TextGold}" Effect="{StaticResource Effect.TextShadow}"
                           Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextDim}" FontSize="11"
                               Effect="{StaticResource Effect.TextShadow}">
                        <Run Text="версия" />
                        <Run Text="{Binding Updates.CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="Logo" Background="Transparent" VerticalAlignment="Center" FontSize="30" FontWeight="Black"
                           Effect="{StaticResource Effect.TextShadow}">
                    <Run Text="g" Foreground="{DynamicResource Brush.AccentLight}" /><Run Text="Launcher" />
                </TextBlock>
            </DockPanel>
        </Grid>

        <!-- Баннер обновления: виден, когда на GitHub есть версия новее -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush.Banner}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="0,0,0,2" Padding="12,8"
                Visibility="{Binding Updates.Available, Converter={StaticResource NotNullToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Обновить" Command="{Binding Updates.InstallCommand}" Background="{DynamicResource Brush.Accent}" Margin="6,0,0,0" />
                    <Button Content="Что нового" Command="{Binding Updates.OpenReleasePageCommand}" Margin="6,0,0,0" />
                    <Button Content="Позже" Command="{Binding Updates.DismissCommand}" Margin="6,0,0,0" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Updates.AvailableText}" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}" />
                    <ProgressBar Margin="0,4,12,0" Value="{Binding Updates.ProgressValue}"
                                 Visibility="{Binding Updates.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Боковая панель как в официальном лаунчере: игрок сверху, игры, «Настройки» внизу.
             У каждой игры своя страница с вкладками (Играть, Установки, Скины, Список изменений…). -->
        <TabControl Style="{StaticResource SidebarTabControl}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavItem}" />
            </TabControl.Resources>

            <!-- Игрок -->
            <TabItem>
                <TabItem.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}"
                                BorderThickness="2" Background="{DynamicResource Brush.Face}">
                            <Image Source="{Binding Accounts.ActiveFace}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Accounts.Selected.DisplayName, FallbackValue='Нет аккаунта', TargetNullValue='Нет аккаунта'}"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCredited}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextGold}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextGold}"
                                       Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}">
                                <Run Text="★" /> <Run Text="{Binding CreditedPerson.Role, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Accounts.ActiveSubtitle}" FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </DockPanel>
                </TabItem.Header>
                <views:AccountsView DataContext="{Binding Accounts}" />
            </TabItem>

            <TabItem Header="ИГРЫ" Style="{StaticResource NavSection}" />

            <!-- Java Edition -->
            <TabItem IsSelected="True">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1"
                                Background="{themes:PixelTexture Kind=GrassBlock, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding JavaIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Java Edition" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:JavaPlayView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Установки"><views:JavaInstallationsView DataContext="{Binding Java}" /></TabItem>
                    <TabItem Header="Скины"><views:SkinsView DataContext="{Binding Skins}" /></TabItem>
                    <TabItem Header="Моды"><views:ContentView DataContext="{Binding Content}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding JavaPatchNotes}" /></TabItem>
                    <TabItem Header="Журнал"><views:JavaLogView DataContext="{Binding Java}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Bedrock Edition -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1"
                                Background="{themes:PixelTexture Kind=Stone, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding BedrockIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Bedrock Edition" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:BedrockView DataContext="{Binding Bedrock}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Bedrock.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1"
                                Background="{themes:PixelTexture Kind=Planks, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding DungeonsIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Minecraft Dungeons" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Dungeons}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Dungeons.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Dungeons II -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1"
                                Background="{themes:PixelTexture Kind=DarkPlanks, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding DungeonsIIIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Minecraft Dungeons II" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding DungeonsII}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Minecraft Legends -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="22" Height="22" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1"
                                Background="{themes:PixelTexture Kind=MossyStone, TileSize=20}">
                            <!-- Официальная иконка (каталог Microsoft Store); пока не скачана — видна пиксельная -->
                            <Image Source="{Binding LegendsIcon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="Minecraft Legends" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <TabControl>
                    <TabItem Header="Играть"><views:GamePlayView DataContext="{Binding Legends}" /></TabItem>
                    <TabItem Header="Список изменений"><views:PatchNotesView DataContext="{Binding Legends.PatchNotes}" /></TabItem>
                </TabControl>
            </TabItem>

            <!-- Настройки — внизу панели -->
            <TabItem DockPanel.Dock="Bottom">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="18" Width="22" TextAlignment="Center" Margin="0,-2,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Настройки" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SettingsView DataContext="{Binding SettingsPage}" />
            </TabItem>
        </TabControl>    </DockPanel>

    <!-- Слой для пасхалки (падающие блоки) — поверх всего, клики проходят насквозь -->
    <Canvas x:Name="FxLayer" IsHitTestVisible="False" ClipToBounds="True" />
    </Grid>
</Window>







