<UserControl x:Class="GLauncher.Views.BedrockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GLauncher.Views">
    <!-- Вкладка «Играть» Bedrock: обложка, выбор версии (выпуск / Preview), запуск и Microsoft Store -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="ВЕРСИЯ" FontFamily="{DynamicResource Font.Display}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,0,6" />
                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" MaxWidth="340" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource HintText}" Margin="2,6,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" MinWidth="260"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0">
                    <TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource Brush.TextDim}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{Binding StoreButtonText}" Command="{Binding OpenStoreCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                ToolTip="Откроет страницу игры в Microsoft Store" />
                        <Button Content="Проверить" Command="{Binding RefreshInstallCommand}" Style="{StaticResource SmallButton}"
                                ToolTip="Заново проверить, установлена ли игра" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" CornerRadius="22" ClipToBounds="True">
            <Grid>
                <!-- Официальный арт игры (скачивается из каталога Microsoft Store, кэш на диске); пока его нет — куб и заголовок -->
                <Border Style="{StaticResource HeroArtLayer}" CornerRadius="21">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding HeroArt}" Stretch="UniformToFill" AlignmentY="Top" />
                    </Border.Background>
                </Border>
                <Border Style="{StaticResource HeroArtLayer}" CornerRadius="21">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.5" />
                            <GradientStop Color="#D9070A10" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <!-- Арт актуальной версии (как в официальном лаунчере): размытый фон из него же, чёткая картинка справа -->
                <Grid Visibility="{Binding VersionArt, Converter={StaticResource NotNullToVisibility}}">
                    <Border>
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding VersionArt}" Stretch="UniformToFill" />
                        </Border.Background>
                        <Border.Effect>
                            <BlurEffect Radius="60" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border.CacheMode>
                            <BitmapCache />
                        </Border.CacheMode>
                    </Border>
                    <Border CornerRadius="21" Background="#8C070A10" />
                    <Viewbox HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,40,48,40" StretchDirection="DownOnly">
                        <Border Width="440" Height="440" CornerRadius="18" BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1.5">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding VersionArt}" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                        </Border>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="48,0,500,0">
                        <TextBlock Text="BEDROCK EDITION" Style="{StaticResource HeroSubtitle}" />
                        <TextBlock Text="Minecraft" Style="{StaticResource HeroTitle}" FontSize="44" Margin="-2,-2,0,0" />
                        <TextBlock Text="{Binding VersionArtTitle}" FontFamily="{DynamicResource Font.Display}" FontSize="17" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextGold}" Margin="0,10,0,0" />
                        <TextBlock Text="Общий мир с друзьями на консолях и телефонах, Marketplace и Realms." Style="{StaticResource HintText}" FontSize="14" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Style="{StaticResource HeroFallback}">
                <views:HeroCube HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,0,0">
                    <TextBlock Text="BEDROCK EDITION" Style="{StaticResource HeroSubtitle}" />
                    <TextBlock Text="Minecraft" Style="{StaticResource HeroTitle}" FontSize="60" Margin="-2,-2,0,0" />
                    <TextBlock Text="Minecraft for Windows: общий мир с друзьями на консолях и телефонах, Marketplace и Realms."
                               Style="{StaticResource HintText}" MaxWidth="380" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>
                <!-- Статус и прогресс — внизу обложки, поверх арта -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,28">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="520" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
