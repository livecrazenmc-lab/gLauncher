<UserControl x:Class="GLauncher.Views.BedrockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="10" Width="640" HorizontalAlignment="Left">
        <TextBlock Text="{Binding LicenseStatus}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,14"
                   Effect="{StaticResource Effect.TextShadow}" />

        <GroupBox Header="Minecraft for Windows" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="ИГРАТЬ" Command="{Binding PlayReleaseCommand}" Style="{StaticResource PlayButton}" />
                <TextBlock Text="{Binding ReleaseStatus}" VerticalAlignment="Center" Margin="4,0,16,0" />
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Minecraft Preview" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Играть" Command="{Binding PlayPreviewCommand}" MinWidth="180" MinHeight="40" />
                <TextBlock Text="{Binding PreviewStatus}" VerticalAlignment="Center" Margin="4,0,16,0" />
            </DockPanel>
        </GroupBox>

        <Button Content="Обновить статус установки" Command="{Binding RefreshInstallCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding Status}" Style="{StaticResource HintText}" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>

