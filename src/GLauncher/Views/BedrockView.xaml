<UserControl x:Class="GLauncher.Views.BedrockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <TextBlock Text="{Binding LicenseStatus}" Margin="0,0,0,12" />

        <GroupBox Header="Minecraft for Windows" Margin="0,0,0,8">
            <DockPanel Margin="6">
                <Button DockPanel.Dock="Right" Content="Играть" Command="{Binding PlayReleaseCommand}" Padding="24,6" FontWeight="Bold" />
                <TextBlock Text="{Binding ReleaseStatus}" VerticalAlignment="Center" />
            </DockPanel>
        </GroupBox>

        <GroupBox Header="Minecraft Preview" Margin="0,0,0,8">
            <DockPanel Margin="6">
                <Button DockPanel.Dock="Right" Content="Играть" Command="{Binding PlayPreviewCommand}" Padding="24,6" />
                <TextBlock Text="{Binding PreviewStatus}" VerticalAlignment="Center" />
            </DockPanel>
        </GroupBox>

        <Button Content="Обновить статус установки" Command="{Binding RefreshInstallCommand}"
                HorizontalAlignment="Left" Padding="8,4" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
