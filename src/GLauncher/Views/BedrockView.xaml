<UserControl x:Class="GLauncher.Views.BedrockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вкладка «Играть» Bedrock: обложка, выбор версии (выпуск / Preview), запуск и Microsoft Store -->
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource Brush.PanelDeep}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Версия" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding SelectedChannel}" MinWidth="240" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" MinWidth="240"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold"
                               Effect="{StaticResource Effect.TextShadow}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="{Binding StoreButtonText}" Command="{Binding OpenStoreCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                                ToolTip="Откроет страницу игры в Microsoft Store" />
                        <Button Content="Проверить" Command="{Binding RefreshInstallCommand}" Style="{StaticResource SmallButton}"
                                ToolTip="Заново проверить, установлена ли игра" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <Border Background="{DynamicResource Texture.Background}" />
                <Border Background="#73000000" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock Text="MINECRAFT" FontSize="44" FontWeight="Black" HorizontalAlignment="Center" Effect="{StaticResource Effect.TextShadow}" />
                    <TextBlock Text="BEDROCK EDITION" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush.AccentLight}" Effect="{StaticResource Effect.TextShadow}" />
                    <TextBlock Text="Minecraft for Windows" Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" MaxWidth="560"
                               Effect="{StaticResource Effect.TextShadow}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
