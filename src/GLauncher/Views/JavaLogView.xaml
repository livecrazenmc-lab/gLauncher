<UserControl x:Class="GLauncher.Views.JavaLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Журнал игры Java Edition -->
    <DockPanel Margin="6">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearLogCommand}" Style="{StaticResource SmallButton}" />
            <TextBlock Text="Вывод игры и установщиков" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox ItemsSource="{Binding Log}" Style="{StaticResource ConsoleList}" VirtualizingPanel.IsVirtualizing="True" />
    </DockPanel>
</UserControl>
