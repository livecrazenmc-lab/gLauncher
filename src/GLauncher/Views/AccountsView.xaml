<UserControl x:Class="GLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Добавить аккаунт Microsoft" Command="{Binding AddCommand}" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="Проверить лицензии" Command="{Binding RefreshCommand}" Padding="8,4" Margin="0,0,6,0" />
            <Button Content="Удалить" Command="{Binding RemoveCommand}" Padding="8,4" />
        </StackPanel>

        <!-- Панель входа по коду: видна только во время входа -->
        <GroupBox DockPanel.Dock="Top" Header="Вход в аккаунт Microsoft" Margin="0,0,0,8"
                  Visibility="{Binding DeviceCode, Converter={StaticResource NotNullToVisibility}}">
            <StackPanel Margin="6">
                <TextBlock Text="1. Откройте страницу входа (уже открыта в браузере):" />
                <TextBox IsReadOnly="True" Text="{Binding DeviceCode.VerificationUri, Mode=OneWay}" Margin="0,2,0,6" />
                <TextBlock Text="2. Введите код (уже скопирован в буфер обмена):" />
                <TextBox IsReadOnly="True" FontSize="22" Text="{Binding DeviceCode.UserCode, Mode=OneWay}" Margin="0,2,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Открыть страницу" Command="{Binding OpenLoginPageCommand}" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Скопировать код" Command="{Binding CopyCodeCommand}" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Отмена" Command="{Binding CancelLoginCommand}" Padding="8,4" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />

        <!-- Выбранный элемент = активный аккаунт -->
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                        <TextBlock>
                            <Run Text="Java Edition:" />
                            <Run Text="{Binding OwnsJava, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                            <Run Text="   Bedrock Edition:" />
                            <Run Text="{Binding OwnsBedrock, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="Xbox:" />
                            <Run Text="{Binding Gamertag, Mode=OneWay, TargetNullValue='—'}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
