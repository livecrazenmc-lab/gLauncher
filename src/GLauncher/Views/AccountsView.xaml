<UserControl x:Class="GLauncher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="6">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить аккаунт Microsoft" Command="{Binding AddCommand}" Background="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
            <Button Content="Проверить лицензии" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
            <Button Content="Удалить" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}" />
        </StackPanel>

        <!-- Панель входа по коду: видна только во время входа -->
        <GroupBox DockPanel.Dock="Top" Header="Вход в аккаунт Microsoft" Margin="0,0,0,10"
                  Visibility="{Binding DeviceCode, Converter={StaticResource NotNullToVisibility}}">
            <StackPanel>
                <TextBlock Text="1. Откройте страницу входа (уже открыта в браузере):" Style="{StaticResource HintText}" />
                <TextBox IsReadOnly="True" Text="{Binding DeviceCode.VerificationUri, Mode=OneWay}" Margin="0,4,0,10" />
                <TextBlock Text="2. Введите код (уже скопирован в буфер обмена):" Style="{StaticResource HintText}" />
                <TextBox IsReadOnly="True" FontSize="26" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center"
                         Text="{Binding DeviceCode.UserCode, Mode=OneWay}" Margin="0,4,0,10" Width="260" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Открыть страницу" Command="{Binding OpenLoginPageCommand}" Margin="0,0,8,0" />
                    <Button Content="Скопировать код" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0" />
                    <Button Content="Отмена" Command="{Binding CancelLoginCommand}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource HintText}" Margin="0,10,0,0" />

        <!-- Выбранный элемент = активный аккаунт -->
        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Effect="{StaticResource Effect.TextShadow}" />
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="Java Edition:" Foreground="{DynamicResource Brush.TextDim}" />
                            <Run Text="{Binding OwnsJava, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                            <Run Text="    Bedrock Edition:" Foreground="{DynamicResource Brush.TextDim}" />
                            <Run Text="{Binding OwnsBedrock, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                            <Run Text="    Xbox:" Foreground="{DynamicResource Brush.TextDim}" />
                            <Run Text="{Binding Gamertag, Mode=OneWay, TargetNullValue='—'}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

