<UserControl x:Class="GLauncher.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <DockPanel Margin="6">
        <!-- Профиль и тип контента -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Right" Width="160" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" />
            <TextBlock Text="{Binding ProfileInfo}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}"
                       ToolTip="Профиль выбирается на вкладке Java Edition" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Style="{StaticResource HintText}" Margin="0,8,0,0" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Поиск на Modrinth -->
            <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Найти" Command="{Binding SearchCommand}" IsDefault="True" Background="{DynamicResource Brush.Accent}" Margin="6,0,0,0" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск на Modrinth. Пусто — самые популярные." />
                </DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Показать ещё" Command="{Binding LoadMoreCommand}"
                        HorizontalAlignment="Left" Margin="0,6,0,0" />
                <ListBox ItemsSource="{Binding Results}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✔ установлено" Foreground="{DynamicResource Brush.AccentLight}" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="Установить" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.InstallCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    <Button Content="Страница" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                            Command="{Binding DataContext.OpenPageCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="  автор:" Foreground="{DynamicResource Brush.TextDim}" />
                                        <Run Text="{Binding Author, Mode=OneWay}" />
                                        <Run Text="  загрузок:" Foreground="{DynamicResource Brush.TextDim}" />
                                        <Run Text="{Binding Downloads, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Установленное в профиле -->
            <DockPanel Grid.Column="1" Width="320" Margin="8,0,0,0"
                       Visibility="{Binding ShowsInstalled, Converter={StaticResource BoolToVisibility}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Обновить" Command="{Binding RefreshInstalledListCommand}" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                        <Button Content="Папка" Command="{Binding OpenFolderCommand}" Style="{StaticResource SmallButton}" />
                    </StackPanel>
                    <TextBlock Text="Установлено в профиле" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Installed}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <Button DockPanel.Dock="Right" Content="Удалить" Style="{StaticResource SmallButton}" Background="{DynamicResource Brush.Danger}" Margin="6,0,0,0"
                                        Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"
                                          ToolTip="Включён" Margin="0,0,6,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" FontSize="10" Foreground="{DynamicResource Brush.TextDim}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>


