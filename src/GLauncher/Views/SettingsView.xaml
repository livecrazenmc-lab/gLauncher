<UserControl x:Class="GLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="8">
        <GroupBox Header="Вход через Microsoft" Margin="0,0,0,8">
            <StackPanel Margin="6">
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Client ID приложения Azure (Microsoft Entra). Тип учётных записей — «только личные аккаунты Microsoft», включён «Allow public client flows». Приложение должно быть одобрено Mojang для доступа к Minecraft API." />
                <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Сохранить" Command="{Binding SaveCommand}" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Как зарегистрировать приложение" Command="{Binding OpenAzureGuideCommand}" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Заявка на доступ к Minecraft API" Command="{Binding OpenApprovalFormCommand}" Padding="8,4" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" Margin="0,6,0,0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Данные лаунчера">
            <DockPanel Margin="6">
                <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenDataFolderCommand}" Padding="8,4" Margin="6,0,0,0" />
                <TextBox IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}" VerticalAlignment="Center" />
            </DockPanel>
        </GroupBox>
    </StackPanel>
</UserControl>
