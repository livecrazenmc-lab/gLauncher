<UserControl x:Class="GLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,10">
            <!-- О лаунчере: иконка, название, версия -->
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,14">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="{StaticResource Img.Logo}" Width="64" Height="64" Margin="0,0,18,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center" DataContext="{Binding Updates}">
                        <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="26">
                            <Run Text="g" Foreground="{DynamicResource Brush.Accent}" /><Run Text="Launcher" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,2,0,0">
                            <Run Text="Версия" /> <Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="· лаунчер Minecraft Java и Bedrock" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <GroupBox Header="Оформление" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentThemeText}" Style="{StaticResource HintText}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Шрифт:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFont}" MaxDropDownHeight="360"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- Предпросмотр: название шрифта его же начертанием -->
                                    <TextBlock Text="{Binding Title}" FontFamily="{Binding Preview}" FontSize="14" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <CheckBox Content="Системная рамка окна (цвет подстраивается под тему)" IsChecked="{Binding SystemFrame}" Margin="0,12,0,0"
                              ToolTip="Обычный заголовок Windows вместо заголовка gLauncher. Цвет рамки меняется вместе с темой (Windows 11)" />
                    <CheckBox Content="Анимированный фон (снег, листья, лепестки — по теме)" IsChecked="{Binding AnimatedBackground}" Margin="0,12,0,0" />
                    <TextBlock Text="★ Вам открыты эксклюзивные темы — спасибо, что вы в благодарностях!" Margin="0,8,0,0"
                               Foreground="{DynamicResource Brush.TextGold}" FontWeight="SemiBold"
                               Visibility="{Binding HasExclusiveThemes, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Запуск игры" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="После запуска Java Edition:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding AfterLaunchOptions}" SelectedItem="{Binding SelectedAfterLaunch}" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Обновления" Margin="0,0,0,12" DataContext="{Binding Updates}">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Текущая версия:" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                    <CheckBox Content="Проверять обновления при запуске" IsChecked="{Binding CheckOnStartup}" Margin="0,6,0,0" />
                    <CheckBox Content="Устанавливать обновления автоматически" IsChecked="{Binding AutoInstall}" Margin="0,6,0,6"
                              IsEnabled="{Binding CheckOnStartup}"
                              ToolTip="Новая версия скачивается при запуске и ставится сама; перезапуск — когда не идёт игра или загрузка" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Проверить сейчас" Command="{Binding CheckNowCommand}" Margin="0,0,6,0" />
                        <Button Content="Установить обновление" Command="{Binding InstallCommand}"
                                Visibility="{Binding Available, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource WarningText}" Margin="0,8,0,0"
                               Visibility="{Binding IsSupported, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Это отладочная сборка: проверка работает, но установка обновлений доступна только в опубликованном gLauncher.exe." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Благодарности" Margin="0,0,0,12" DataContext="{Binding Credits}">
                <!-- Ники и скины подтягиваются по UUID при каждом запуске (офлайн — из кэша) -->
                <ItemsControl ItemsSource="{Binding People}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Border DockPanel.Dock="Left" Width="46" Height="46" Margin="0,0,14,0" CornerRadius="12"
                                        Background="{DynamicResource Brush.Face}" BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1.5">
                                    <Image Source="{Binding Face}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" Margin="1">
                                        <Image.Clip><RectangleGeometry Rect="0,0,41,41" RadiusX="10" RadiusY="10" /></Image.Clip>
                                    </Image>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontFamily="{DynamicResource Font.Display}" FontSize="16" />
                                    <TextBlock Text="{Binding Role}" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <!-- Игрокам здесь ничего настраивать не нужно: Client ID вшит в лаунчер -->
            <!-- Видят только люди из благодарностей (по UUID аккаунта); список — credits.json на GitHub -->
            <GroupBox Header="Для разработчиков" Margin="0,0,0,12"
                      Visibility="{Binding ShowDeveloper, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding BuiltInClientIdStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                               Text="Свой Client ID приложения Azure — необязательно, только для тестов. Пусто — используется встроенный." />
                    <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                        <Button Content="Регистрация приложения" Command="{Binding OpenAzureGuideCommand}" Margin="0,0,6,0" />
                        <Button Content="Заявка в Mojang" Command="{Binding OpenApprovalFormCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Данные лаунчера" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenDataFolderCommand}" Margin="6,0,0,0" />
                    <TextBox IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}" VerticalAlignment="Center" />
                </DockPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>


