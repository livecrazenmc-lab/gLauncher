<UserControl x:Class="GLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" MaxWidth="900" HorizontalAlignment="Left">
            <GroupBox Header="Оформление" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="Тема:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentThemeText}" Style="{StaticResource HintText}"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Запуск игры" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="После запуска Java Edition:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding AfterLaunchOptions}" SelectedItem="{Binding SelectedAfterLaunch}" />
                </DockPanel>
            </GroupBox>

            <GroupBox Header="Обновления" Margin="0,0,0,12" DataContext="{Binding Updates}">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Текущая версия:" />
                        <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                    </TextBlock>
                    <CheckBox Content="Проверять обновления при запуске" IsChecked="{Binding CheckOnStartup}" Margin="0,6,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Проверить сейчас" Command="{Binding CheckNowCommand}" Margin="0,0,6,0" />
                        <Button Content="Установить обновление" Command="{Binding InstallCommand}"
                                Visibility="{Binding Available, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource WarningText}" Margin="0,8,0,0"
                               Visibility="{Binding IsSupported, Converter={StaticResource InverseBoolToVisibility}}"
                               Text="Это отладочная сборка: проверка работает, но установка обновлений доступна только в опубликованном gLauncher.exe." />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Благодарности" Margin="0,0,0,12" DataContext="{Binding Credits}">
                <!-- Ники и скины подтягиваются по UUID при каждом запуске (офлайн — из кэша) -->
                <ItemsControl ItemsSource="{Binding People}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,4">
                                <Border DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,12,0"
                                        Background="{DynamicResource Brush.Face}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2">
                                    <Image Source="{Binding Face}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Effect="{StaticResource Effect.TextShadow}" />
                                    <TextBlock Text="{Binding Role}" Style="{StaticResource HintText}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <!-- Игрокам здесь ничего настраивать не нужно: Client ID вшит в лаунчер -->
            <GroupBox Header="Для разработчиков" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding BuiltInClientIdStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,6"
                               Text="Свой Client ID приложения Azure — необязательно, только для тестов. Пусто — используется встроенный." />
                    <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Сохранить" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                        <Button Content="Регистрация приложения" Command="{Binding OpenAzureGuideCommand}" Margin="0,0,6,0" />
                        <Button Content="Заявка в Mojang" Command="{Binding OpenApprovalFormCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Данные лаунчера" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Открыть" Command="{Binding OpenDataFolderCommand}" Margin="6,0,0,0" />
                    <TextBox IsReadOnly="True" Text="{Binding DataFolder, Mode=OneWay}" VerticalAlignment="Center" />
                </DockPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>


