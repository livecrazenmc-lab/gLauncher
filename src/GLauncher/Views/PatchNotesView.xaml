<UserControl x:Class="GLauncher.Views.PatchNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:GLauncher.Controls">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <CheckBox DockPanel.Dock="Top" Content="Показывать снапшоты" IsChecked="{Binding ShowSnapshots}" Margin="2,0,0,8"
                      Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVisibility}}" />
            <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <controls:HtmlText Html="{Binding Body}" />
        </Border>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" Style="{StaticResource HintText}" Margin="0,6,0,0" />
    </Grid>
</UserControl>

