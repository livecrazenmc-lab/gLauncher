<UserControl x:Class="GLauncher.Views.JavaPlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GLauncher.Views">
    <!-- Вкладка «Играть»: обложка с парящим кубом и нижняя панель — установка, «Играть», лицензия -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="УСТАНОВКА" FontFamily="{StaticResource Font.Display}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,0,6" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalAlignment="Stretch" MaxWidth="380">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}">
                                        <Run Text="{Binding MinecraftVersion, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Loader, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" MinWidth="260" />
                    <Button Content="Отмена" Command="{Binding CancelCommand}" Style="{StaticResource SmallButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding LicenseStatus}" TextWrapping="Wrap" TextAlignment="Right"
                           VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0" Foreground="{DynamicResource Brush.TextDim}" />
            </Grid>
        </Border>

        <!-- Обложка -->
        <Border Style="{StaticResource Card}" CornerRadius="22" ClipToBounds="True">
            <Grid>
                <views:HeroCube HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,0,0">
                    <TextBlock Text="JAVA EDITION" Style="{StaticResource HeroSubtitle}" />
                    <TextBlock Text="Minecraft" Style="{StaticResource HeroTitle}" FontSize="60" Margin="-2,-2,0,0" />
                    <TextBlock Text="Оригинальная версия для ПК: моды, сервера, снапшоты и любые версии игры."
                               Style="{StaticResource HintText}" MaxWidth="380" FontSize="14" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="440" Margin="0,22,0,0" FontWeight="SemiBold" />
                    <ProgressBar Margin="0,10,0,0" Width="380" HorizontalAlignment="Left" Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
