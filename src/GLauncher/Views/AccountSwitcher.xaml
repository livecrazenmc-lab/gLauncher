<UserControl x:Class="GLauncher.Views.AccountSwitcher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GLauncher"
             x:Name="Root">
    <!-- DataContext — MainViewModel (аккаунты в Accounts, «плюшки» благодарностей в IsCredited/CreditedPerson) -->
    <UserControl.Resources>
        <local:EqualsMultiConverter x:Key="IsActiveAccount" />
        <local:UuidToFaceConverter x:Key="CachedFace" />
    </UserControl.Resources>

    <Grid x:Name="Anchor">
        <!-- Нет аккаунта: сразу кнопка входа -->
        <Button x:Name="AddButton" Command="{Binding Accounts.AddCommand}" Height="52" HorizontalAlignment="Stretch">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Accounts.Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Text="Добавить аккаунт" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Есть аккаунт: карточка игрока, щелчок открывает список -->
        <Button x:Name="CardButton" Click="OnCardClick" Cursor="Hand" ToolTip="Сменить аккаунт">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Padding="8,8,10,8">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Accounts.Selected}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" CornerRadius="12"
                        BorderBrush="{DynamicResource Brush.OutlineStrong}" BorderThickness="1.5" Background="{DynamicResource Brush.Face}">
                    <Image Source="{Binding Accounts.ActiveFace}" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="1">
                        <Image.Clip><RectangleGeometry Rect="0,0,35,35" RadiusX="10" RadiusY="10" /></Image.Clip>
                    </Image>
                </Border>
                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform><RotateTransform /></TextBlock.RenderTransform>
                </TextBlock>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Accounts.Selected.DisplayName}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCredited}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextGold}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.TextGold}"
                               Visibility="{Binding IsCredited, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="★" /> <Run Text="{Binding CreditedPerson.Role, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Accounts.ActiveSubtitle}" FontSize="11" FontWeight="Normal"
                               Foreground="{DynamicResource Brush.TextDim}" />
                </StackPanel>
            </DockPanel>
        </Button>

        <!-- Выпадающий список: быстрая смена, перетаскивание для порядка, вход и проверка лицензий -->
        <Popup x:Name="Panel" PlacementTarget="{Binding ElementName=Anchor}" Placement="Bottom" VerticalOffset="-6" HorizontalOffset="-12"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="OnPanelOpened" Closed="OnPanelClosed">
            <Grid Margin="12" DataContext="{Binding Accounts}">
                <Border Width="320" Padding="10" CornerRadius="16" Background="{DynamicResource Brush.Popup}"
                        BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="1" TextElement.Foreground="{DynamicResource Brush.Text}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel Margin="6,2,6,8">
                            <TextBlock DockPanel.Dock="Right" Text="перетащите, чтобы упорядочить" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                            <TextBlock Text="АККАУНТЫ" FontFamily="{DynamicResource Font.Display}" FontSize="11"
                                       Foreground="{DynamicResource Brush.TextDim}" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl x:Name="List" ItemsSource="{Binding Items}" AllowDrop="True"
                                      PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                                      PreviewMouseLeftButtonUp="OnListMouseUp" DragOver="OnListDragOver" Drop="OnListDrop">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="10" Padding="8,6" Margin="0,1" Background="Transparent" Cursor="Hand">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Width="30" Height="30"
                                                    Content="&#xE711;" FontSize="10" ToolTip="Удалить аккаунт" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.Accounts.RemoveAccountCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed" />
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0" CornerRadius="9"
                                                    Background="{DynamicResource Brush.Face}">
                                                <Image Source="{Binding Uuid, Converter={StaticResource CachedFace}}" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                                    <Image.Clip><RectangleGeometry Rect="0,0,34,34" RadiusX="9" RadiusY="9" /></Image.Clip>
                                                </Image>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}">
                                                    <Run Text="Java:" /> <Run Text="{Binding OwnsJava, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                                                    <Run Text=" · Bedrock:" /> <Run Text="{Binding OwnsBedrock, Mode=OneWay, Converter={StaticResource LicenseText}}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Hover}" />
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource IsActiveAccount}">
                                                    <Binding />
                                                    <Binding Path="DataContext.Accounts.Selected" ElementName="Root" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Вход по коду: виден только во время входа -->
                        <Border Margin="0,8,0,0" Padding="12" CornerRadius="12" Background="{DynamicResource Brush.Field}"
                                Visibility="{Binding DeviceCode, Converter={StaticResource NotNullToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Введите код на открывшейся странице Microsoft (код уже скопирован):" TextWrapping="Wrap"
                                           Style="{StaticResource HintText}" />
                                <TextBox IsReadOnly="True" FontSize="24" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center"
                                         Text="{Binding DeviceCode.UserCode, Mode=OneWay}" Margin="0,8" />
                                <UniformGrid Columns="3">
                                    <Button Content="Страница" Command="{Binding OpenLoginPageCommand}" Style="{StaticResource SmallButton}" Margin="0,0,3,0" />
                                    <Button Content="Копировать" Command="{Binding CopyCodeCommand}" Style="{StaticResource SmallButton}" Margin="3,0" />
                                    <Button Content="Отмена" Command="{Binding CancelLoginCommand}" Style="{StaticResource SmallButton}" Margin="3,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Button Command="{Binding AddCommand}" Style="{StaticResource AccentButton}" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Добавить" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshCommand}" Margin="4,0,0,0" ToolTip="Обновить вход и перепроверить лицензии активного аккаунта">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Лицензии" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="4,8,4,0"
                                   Visibility="{Binding Status, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
    </Grid>
</UserControl>
