<UserControl x:Class="GLauncher.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GLauncher.Views">
    <!-- Вкладка «Играть» для Minecraft Dungeons / Dungeons II / Legends -->
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="УСТАНОВКА" FontFamily="{DynamicResource Font.Display}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="2,0,0,6" />
                    <ComboBox ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}" MaxWidth="320" HorizontalAlignment="Stretch"
                              DisplayMemberPath="Source" Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource HintText}" Margin="2,6,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" MinWidth="260"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,0,0">
                    <TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap" TextAlignment="Right" Foreground="{DynamicResource Brush.TextDim}" />
                    <Button Content="Microsoft Store" Command="{Binding OpenStoreCommand}" Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Right" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource Card}" CornerRadius="22" ClipToBounds="True">
            <Grid>
                <!-- Официальный арт игры (скачивается из каталога Microsoft Store, кэш на диске); пока его нет — куб и заголовок -->
                <Border Style="{StaticResource HeroArtLayer}" CornerRadius="21">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding HeroArt}" Stretch="UniformToFill" AlignmentY="Top" />
                    </Border.Background>
                </Border>
                <Border Style="{StaticResource HeroArtLayer}" CornerRadius="21">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.5" />
                            <GradientStop Color="#D9070A10" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Style="{StaticResource HeroFallback}">
                <views:HeroCube HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="52,0,0,0" MaxWidth="560">
                    <TextBlock Text="СЕМЕЙСТВО MINECRAFT" Style="{StaticResource HeroSubtitle}" />
                    <TextBlock Text="{Binding Title}" Style="{StaticResource HeroTitle}" FontSize="44" TextWrapping="Wrap" Margin="-1,0,0,0" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource HintText}" MaxWidth="400" FontSize="14" Margin="0,8,0,0" />
                </StackPanel>
                </Grid>
                <!-- Статус и прогресс — внизу обложки, поверх арта -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="40,0,40,28">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxWidth="520" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
