<UserControl x:Class="GLauncher.Views.GamePlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Вкладка «Играть» для Minecraft Dungeons / Dungeons II / Legends -->
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="14,10"
                Background="{DynamicResource Brush.PanelDeep}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Установка" Style="{StaticResource HintText}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}" MinWidth="240" HorizontalAlignment="Left"
                              DisplayMemberPath="Source" Visibility="{Binding HasInstalls, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding InstallStatus}" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" MinWidth="240"
                        VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="{Binding LicenseStatus}" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold"
                               Effect="{StaticResource Effect.TextShadow}" />
                    <Button Content="Microsoft Store" Command="{Binding OpenStoreCommand}" Style="{StaticResource SmallButton}"
                            HorizontalAlignment="Right" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2" ClipToBounds="True">
            <Grid>
                <Border Background="{DynamicResource Texture.Background}" />
                <Border Background="#80000000" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <TextBlock Text="{Binding Title}" FontSize="38" FontWeight="Black" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" Effect="{StaticResource Effect.TextShadow}" />
                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" Margin="0,10,0,0"
                               Foreground="{DynamicResource Brush.TextDim}" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" MaxWidth="560"
                               Effect="{StaticResource Effect.TextShadow}" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
