<UserControl x:Class="GLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Список профилей -->
        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,8,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Новый" Command="{Binding NewProfileCommand}" Padding="8,4" Margin="0,0,6,0" />
                <Button Content="Удалить" Command="{Binding DeleteProfileCommand}" Padding="8,4" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Редактор профиля -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Название" Margin="0,4" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                <TextBlock Grid.Row="1" Text="Модлоадер" Margin="0,4" />
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Loaders}" SelectedItem="{Binding EditLoader}" Margin="0,2" />

                <TextBlock Grid.Row="2" Text="Версия Minecraft" Margin="0,4" />
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                    <CheckBox DockPanel.Dock="Right" Content="Снапшоты" IsChecked="{Binding ShowSnapshots}"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                    <ComboBox ItemsSource="{Binding McVersions}" IsEditable="True"
                              Text="{Binding EditMcVersion, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Версия Fabric / Forge" Margin="0,4" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditLoaderVersion, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Пусто — последняя стабильная (рекомендованная)" Margin="0,2" />

                <TextBlock Grid.Row="4" Text="Память, МБ" Margin="0,4" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditMemoryMb, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                <TextBlock Grid.Row="5" Text="Разрешение (Ш × В)" Margin="0,4" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                    <TextBox Width="80" Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text=" × " VerticalAlignment="Center" />
                    <TextBox Width="80" Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="  пусто — по умолчанию" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="6" Text="Папка игры" Margin="0,4" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditGameDir, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Пусто — отдельная папка профиля в данных лаунчера" Margin="0,2" />

                <TextBlock Grid.Row="7" Text="Путь к java.exe" Margin="0,4" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditJavaPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Пусто — лаунчер сам скачает нужную Java" Margin="0,2" />

                <TextBlock Grid.Row="8" Text="Аргументы JVM" Margin="0,4" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditJvmArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,2" />

                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Сохранить профиль" Command="{Binding SaveProfileCommand}" Padding="8,4" Margin="0,0,6,0" />
                    <Button Content="Открыть папку игры" Command="{Binding OpenGameFolderCommand}" Padding="8,4" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Запуск -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8">
            <Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelPlayCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Padding="8,4" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Играть" Command="{Binding PlayCommand}" Padding="24,6" FontWeight="Bold" />
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{Binding LicenseStatus}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                <ProgressBar Height="8" Margin="0,4,0,0" Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>

        <!-- Журнал игры -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearLogCommand}" Padding="6,2" />
                <TextBlock Text="Журнал" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Log}" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                     VirtualizingPanel.IsVirtualizing="True" />
        </DockPanel>
    </Grid>
</UserControl>
