<UserControl x:Class="GLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
        </Grid.RowDefinitions>

        <!-- Список профилей -->
        <DockPanel Grid.Column="0" Grid.Row="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Профили" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <UniformGrid Columns="2">
                    <Button Content="Новый" Command="{Binding NewProfileCommand}" Margin="0,0,3,0" />
                    <Button Content="Удалить" Command="{Binding DeleteProfileCommand}" Style="{StaticResource DangerButton}" Margin="3,0,0,0" />
                </UniformGrid>
                <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Content="Импорт" Command="{Binding ImportMrpackCommand}" ToolTip="Импорт сборки .mrpack" Margin="0,0,3,0" />
                    <Button Content="Экспорт" Command="{Binding ExportMrpackCommand}" ToolTip="Экспорт профиля в .mrpack" Margin="3,0,0,0" />
                </UniformGrid>
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextDim}">
                                <Run Text="{Binding MinecraftVersion, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Loader, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Редактор профиля -->
        <DockPanel Grid.Column="1" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Настройки профиля" Style="{StaticResource SectionTitle}" Margin="2,0,0,6" />
            <Border Background="{DynamicResource Brush.PanelDeep}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Название" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                        <TextBlock Grid.Row="1" Text="Модлоадер" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Loaders}" SelectedItem="{Binding EditLoader}" Margin="0,3" />

                        <TextBlock Grid.Row="2" Text="Версия Minecraft" Style="{StaticResource FieldLabel}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3">
                            <CheckBox DockPanel.Dock="Right" Content="Снапшоты" IsChecked="{Binding ShowSnapshots}"
                                      VerticalAlignment="Center" Margin="10,0,0,0" />
                            <ComboBox ItemsSource="{Binding McVersions}" IsEditable="True"
                                      Text="{Binding EditMcVersion, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>

                        <TextBlock Grid.Row="3" Text="Версия модлоадера" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditLoaderVersion, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Пусто — последняя стабильная (рекомендованная)" Margin="0,3" />

                        <TextBlock Grid.Row="4" Text="Память, МБ" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryHint}" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="10,0,0,0" />
                                <TextBox Text="{Binding EditMemoryMb, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Text="{Binding MemoryWarning}" Style="{StaticResource WarningText}" Margin="0,4,0,0"
                                       Visibility="{Binding MemoryWarning, Converter={StaticResource NotNullToVisibility}}" />
                        </StackPanel>

                        <TextBlock Grid.Row="5" Text="Разрешение" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                            <TextBox Width="80" Text="{Binding EditWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="×" VerticalAlignment="Center" Margin="8,0" />
                            <TextBox Width="80" Text="{Binding EditHeight, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="пусто — по умолчанию" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>

                        <TextBlock Grid.Row="6" Text="Автовход на сервер" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding EditServerAddress, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Адрес сервера (host или host:port). Игра сразу подключится к нему. Пусто — без автовхода." Margin="0,3" />

                        <TextBlock Grid.Row="7" Text="Папка игры" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding EditGameDir, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Пусто — отдельная папка профиля в данных лаунчера" Margin="0,3" />

                        <TextBlock Grid.Row="8" Text="Путь к java.exe" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding EditJavaPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Пусто — лаунчер сам скачает нужную Java" Margin="0,3" />

                        <TextBlock Grid.Row="9" Text="Аргументы JVM" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding EditJvmArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />

                        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,4">
                            <Button Content="Сохранить профиль" Command="{Binding SaveProfileCommand}" Margin="0,0,8,0" />
                            <Button Content="Открыть папку игры" Command="{Binding OpenGameFolderCommand}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Запуск -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10" Padding="12,10"
                Background="{DynamicResource Brush.PanelDeep}" BorderBrush="{DynamicResource Brush.Outline}" BorderThickness="2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Отмена" Command="{Binding CancelCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="ИГРАТЬ" Command="{Binding PlayCommand}" Style="{StaticResource PlayButton}" />
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LicenseStatus}" FontWeight="SemiBold" Effect="{StaticResource Effect.TextShadow}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                    <ProgressBar Margin="0,6,0,0" Value="{Binding ProgressValue}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Журнал игры -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="Очистить" Command="{Binding ClearLogCommand}" Style="{StaticResource SmallButton}" />
                <TextBlock Text="Журнал" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Log}" Style="{StaticResource ConsoleList}" VirtualizingPanel.IsVirtualizing="True" />
        </DockPanel>
    </Grid>
</UserControl>

