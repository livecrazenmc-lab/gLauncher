<Application x:Class="GLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GLauncher"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Тема «Блоки»: палитра и стили всех контролов -->
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToTextConverter x:Key="LicenseText" TrueText="есть" FalseText="нет" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToVisibilityConverter x:Key="NotNullToVisibility" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
